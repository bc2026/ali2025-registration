# Source or copy values for IAM database auth (Aurora / RDS).
# Your DB user must be allowed for IAM auth (rds_iam role in Postgres) — see AWS docs.
#
#   export RDSHOST=your-cluster.cluster-xxxx.us-east-1.rds.amazonaws.com
#   export AWS_REGION=us-east-1
#   export RDS_USER=postgres
#   export RDS_DB=postgres
#
# Interactive SQL:
#   ./scripts/rds-iam-psql.sh
#
# One-shot Prisma / import (token ~15 min):
#   export DATABASE_URL="$(./scripts/rds-iam-database-url.sh)"
#   npx prisma migrate deploy
#   npm run data:import
#
# Long-running API (Docker on EC2): IAM tokens expire — prefer either:
#   - RDS user + password in Secrets Manager → static DATABASE_URL in .env.aws, or
#   - RDS Proxy + IAM (or password) in front of the cluster.

RDSHOST=your-cluster.cluster-xxxx.us-east-1.rds.amazonaws.com
AWS_REGION=us-east-1
RDS_USER=postgres
RDS_DB=postgres
RDS_PORT=5432
