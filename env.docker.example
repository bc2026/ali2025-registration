# Copy to .env.docker — used when Postgres runs on the SAME host as the app (docker-compose.yml).
# Prisma + API use DATABASE_URL (host `postgres` is the Docker service name).
DATABASE_URL=postgresql://admin:root@postgres:5432/voter_db
# If migrate deploy errors with P3005 (DB already had tables), from the host run:
#   npm run prisma:baseline
# (Docker stack runs an automatic baseline after the first failed deploy.)
PORT=5002

# Append rows to Google Sheet tab "Sheet2" (create the tab if it does not exist).
# SHEETS_ENABLED=1
# GOOGLE_SERVICE_ACCOUNT_JSON=./backend/secret_key.json

# Optional: comma-separated browser origins
# CORS_ORIGINS=http://localhost:3080,https://canivotenj.com

# META_ENABLED=1
