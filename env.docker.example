# Copy to .env.docker — used when Postgres runs on the SAME host as the app (docker-compose.yml).
# Recommended for EC2/VPS: one server runs all three containers; data lives in volume canivotenj_pgdata.
DB_NAME=voter_db
DB_USER=admin
DB_PASSWORD=root
PORT=5002

# Append rows to Google Sheet tab "Sheet2" (create the tab if it does not exist).
# SHEETS_ENABLED=1
# GOOGLE_SERVICE_ACCOUNT_JSON=./backend/secret_key.json

# Optional: comma-separated browser origins
# CORS_ORIGINS=http://localhost:3080,https://canivotenj.com

# META_ENABLED=1
