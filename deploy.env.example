# Copy to deploy.env (gitignored) and fill in. Used by scripts/deploy-ec2.sh from your laptop.
#
# First time on EC2:
#   sudo apt update && sudo apt install -y git docker.io docker-compose-plugin
#   sudo usermod -aG docker "$USER"   # then re-login
#   git clone <your-repo-url> /home/ubuntu/ali2025-registration
#   cd /home/ubuntu/ali2025-registration
#   cp env.docker.example .env.docker && nano .env.docker
#   # Place backend/secret_key.json on the server if using Sheets (never commit it).

EC2_HOST=ec2-44-201-99-56.compute-1.amazonaws.com
EC2_USER=ubuntu
EC2_KEY=~/.ssh/bhag-key.pem

# Remote clone path (must exist and match git method below)
EC2_PATH=/home/ubuntu/ali2025-registration

# git = ssh and git pull (recommended). rsync = copy tree from this machine.
DEPLOY_METHOD=git
GIT_BRANCH=feature/canivotenj

# Passed to scripts/canivotenj-docker.sh
# server = Postgres in Docker. rds = Aurora/RDS only — set DATABASE_URL on the server in .env.aws
DOCKER_MODE=server
WITH_SHEETS=1
