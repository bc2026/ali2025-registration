# Backend + frontend in Docker; Postgres is AWS RDS / Aurora (not the compose stack).
# docker compose -f docker-compose.rds.yml --env-file .env.aws up -d --build
#
# Option A — static password (recommended for Prisma / long-lived Node process):
DATABASE_URL=postgresql://appuser:change-me@your-db.xxxx.us-east-1.rds.amazonaws.com:5432/voter_db?sslmode=require
PORT=5002
#
# Option B — IAM database auth is ~15 min tokens; fine for psql / one-off migrate, awkward for the API.
# See env.rds-iam.example and scripts/rds-iam-psql.sh, scripts/rds-iam-database-url.sh

# Sheet2 append (same spreadsheet as before; add a tab named Sheet2 in Google Sheets).
# SHEETS_ENABLED=1
# GOOGLE_SERVICE_ACCOUNT_JSON=./backend/secret_key.json

# CORS_ORIGINS=https://canivotenj.com,https://www.canivotenj.com,http://localhost:3080

# META_ENABLED=0
