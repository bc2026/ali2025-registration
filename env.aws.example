# Copy to .env.aws for docker-compose.rds.yml (Postgres on AWS RDS).
DB_HOST=your-db.xxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=voter_db
DB_USER=admin
DB_PASSWORD=change-me
PORT=5002

# Sheet2 append (same spreadsheet as before; add a tab named Sheet2 in Google Sheets).
SHEETS_ENABLED=1
GOOGLE_SERVICE_ACCOUNT_JSON=./backend/secret_key.json

CORS_ORIGINS=https://canivotenj.com,https://www.canivotenj.com,http://localhost:3080

# Optional
# META_ENABLED=0
